# Build context for packages/api/Dockerfile (BuildKit reads <Dockerfile>.dockerignore): only what the image copies.
**
!packages/api/package.json
!packages/api/package-lock.json
!packages/api/src/**
!packages/ai/src/**
!packages/ai/prompts/**
!packages/ai/evals/**
!packages/db/package.json
!packages/db/package-lock.json
!packages/db/src/**
!packages/db/migrations/**
!packages/gate/src/**
!packages/sender/src/**
!packages/enrich/src/**
# Dev-only entry points never ship (B-11): dev.mjs accepts unsigned dev tokens, seed-demo.mjs builds the demo tenant.
# Later rules win, so these re-exclude files the packages/api/src/** include above would admit.
packages/api/src/dev.mjs
packages/api/src/seed-demo.mjs
