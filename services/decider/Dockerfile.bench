# CPU benchmark for laya (bench/cpu.py). Not the service image: unpruned transformers, ONNX Runtime, both
# checkpoints. Runs as a one-off Cloud Run job so the numbers come from the production CPU.
FROM python:3.12-slim
ENV PIP_NO_CACHE_DIR=1 PYTHONUNBUFFERED=1 HF_HOME=/models
RUN pip install torch --index-url https://download.pytorch.org/whl/cpu && pip install "laya[onnx]==0.3.23" "transformers==5.18.0"
RUN python -c "from huggingface_hub import snapshot_download as s; s('convaiinnovations/laya', revision='55cf4c4ebb4ebe31b2550e8bdf3bd21b99753851'); s('convaiinnovations/laya-multilingual', revision='e4e9ddf21a7b1903b7acffd8814ad4307bf63a67')"
ENV HF_HUB_OFFLINE=1 LAYA_REVISION=reviewed
COPY bench/ /opt/bench/
# Export at run time (the job has 16 GiB; the default build machine may not), then benchmark.
CMD ["sh", "-c", "mkdir -p /opt/onnx && python /opt/bench/export_onnx.py --model convaiinnovations/laya --output /opt/onnx/laya.onnx --quantize && python /opt/bench/cpu.py"]
