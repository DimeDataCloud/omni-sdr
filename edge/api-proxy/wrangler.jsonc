// api.omnisdr.com -> the Cloud Run API (src/index.mjs). $0: Workers free tier, no Cloud Run domain mapping, no load
// balancer. No secrets. ORIGIN is the omni-api service URL (gcloud run services describe omni-api --format='value(status.url)').
{
  "name": "omnisdr-api-proxy",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "api.omnisdr.com", "custom_domain": true }],
  "vars": { "ORIGIN": "https://omni-api-885132575622.us-central1.run.app" },
  "observability": { "enabled": true }
}
