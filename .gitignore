# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# secrets & keys
/secrets/
*gcs-key*.json


# Omni-SDR additions (2026-09-28)
# dependencies in every package, not only the root
node_modules/
# local runtime data: holds real waitlist signups (PII). Never commit.
/data/
# build and deploy outputs, rebuilt from source
/dist-pages/
/_worker.bundle
/.wrangler/

# Google Drive stubs. This checkout can sit inside a Drive-synced folder, where Drive writes a
# .gdoc/.gsheet/.gslides file for every native Google file. The stub holds the doc id and
# the owner's email, and it is not the document. Never git rm a tracked one: when a checkout
# inside Drive pulls that deletion, Drive can trash the real document.
*.gdoc
*.gsheet
*.gslides
*.gdraw
*.gform
*.gmap
*.gsite

# python
__pycache__/
